# Backend Environment Variables
# Copy this file to .env and update the values

# Database - Replace with your MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/parking_spot_finder?retryWrites=true&w=majority

# JWT Configuration - Change this to a secure random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration - Replace with your frontend URL
FRONTEND_URL=https://your-frontend-domain.com

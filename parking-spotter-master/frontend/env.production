# Frontend Environment Variables for Deployment
# Use these when deploying to Vercel, Netlify, or other platforms

# API Configuration - Replace with your backend URL
REACT_APP_API_URL=https://deploy1-b402.onrender.com/api

# App Configuration
REACT_APP_NAME=Parking Spot Finder
REACT_APP_VERSION=1.0.0

# Map Configuration (Delhi, India coordinates)
REACT_APP_MAP_DEFAULT_LAT=28.6139
REACT_APP_MAP_DEFAULT_LNG=77.2090
REACT_APP_MAP_DEFAULT_ZOOM=13

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG=false
